# Copy to .env and fill in. Never commit .env — it carries secrets.

# --- Server ---
NODE_ENV=development
PORT=4000

# Comma-separated list of origins allowed to call the API with cookies. The Next.js front runs on 3000.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Domain of the admin session cookie. Empty locally; ".gastrospecs.com" in production.
COOKIE_DOMAIN=

# --- Database ---
# DATABASE_URL is what the API uses; DIRECT_URL is what Prisma migrations use.
# Neon: DATABASE_URL = the "-pooler" host, DIRECT_URL = the same URL without "-pooler".
# Local Docker (docker-compose.yml): both are the same URL.
DATABASE_URL=postgresql://gastrospecs:gastrospecs@localhost:5432/gastrospecs?schema=public
DIRECT_URL=postgresql://gastrospecs:gastrospecs@localhost:5432/gastrospecs?schema=public

# --- Auth ---
# Long random string. Rotate in prod. Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Images (Cloudflare R2) ---
# R2 → Manage API tokens → "Object Read & Write" on this bucket only. The API refuses to start if any is missing.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=gastrospecs-media
R2_PUBLIC_URL=https://media.gastrospecs.com

# The owner account is NOT configured here. Create it once by passing the values on the command line
# (see README), so the password never sits in a file.
