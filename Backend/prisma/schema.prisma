// Prisma schema — single source of truth for the database.
// After a change here run:  npm run prisma:migrate -- --name <what-changed>
//
// Bilingual text uses an `En` / `Ar` column pair. Arabic falls back to English when empty.
// Images are stored as object keys inside the R2 bucket (e.g. "products/<id>/<uuid>.webp"),
// never as full URLs, so moving to another domain is a single R2_PUBLIC_URL change.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  /// Migrations need a direct connection; poolers like Neon's "-pooler" host don't support them.
  directUrl = env("DIRECT_URL")
}

/// `owner` can later manage other admins; `admin` manages the catalog only.
enum AdminRole {
  owner
  admin
}

/// Can sign in to the dashboard. Only a bcrypt hash of the password is stored.
model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String?
  role         AdminRole @default(admin)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("admin_users")
}

/// Equipment by function (Frying, Preparation…), two levels deep: a main category and its subcategories.
/// Products always attach to a subcategory; a main category shows everything under it.
model Category {
  id            String                 @id @default(uuid())
  slug          String                 @unique
  nameEn        String
  nameAr        String
  /// Display order everywhere: main equipment (cooking, frying…) first, small items last.
  sortOrder     Int                    @default(0)
  /// Main categories only: the middle part of our product codes, e.g. "FRY" in "GS-FRY-0001".
  codePrefix    String?                @unique
  imageKey      String?
  parentId      String?
  parent        Category?              @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children      Category[]             @relation("CategoryTree")
  products      Product[]
  /// Products whose home is another category but that are also listed here.
  alsoListed    ProductExtraCategory[]
  businessTypes BusinessTypeCategory[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([parentId])
  @@map("categories")
}

/// Kind of venue (Fried chicken, Hotel, Bakery…). Its page shows the subcategories linked to it.
model BusinessType {
  id         String                 @id @default(uuid())
  slug       String                 @unique
  nameEn     String
  nameAr     String
  summaryEn  String?
  summaryAr  String?
  imageKey   String?
  sortOrder  Int                    @default(0)
  categories BusinessTypeCategory[]
  leads      Lead[]
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  @@map("business_types")
}

/// The equipment a venue needs: which subcategories appear on a business type's page.
/// Shown in the categories' own display order, so the link needs no order of its own.
model BusinessTypeCategory {
  businessTypeId String
  businessType   BusinessType @relation(fields: [businessTypeId], references: [id], onDelete: Cascade)
  categoryId     String
  category       Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  /// Position on this venue's page (each venue orders its equipment its own way, e.g. butchery: saws first).
  sortOrder      Int          @default(0)

  @@id([businessTypeId, categoryId])
  @@index([categoryId])
  @@map("business_type_categories")
}

enum EnergyType {
  electric
  gas
  /// Runs on both (e.g. gas burners with electric controls that need mains power to heat).
  dual
}

enum GasType {
  lpg
  natural_gas
}

/// One machine as customers see it. Shown once on the site even when several suppliers make it
/// (see SupplierProduct). Key specs are real columns so the catalog can sort and filter by them;
/// anything else goes into `specs`.
model Product {
  id                    String                 @id @default(uuid())
  /// Our own product number, e.g. "GS-FRY-0001". Never a supplier's model code.
  code                  String                 @unique
  slug                  String                 @unique
  nameEn                String
  nameAr                String
  summaryEn             String?
  summaryAr             String?
  /// Extra specs shared by every variant: [{ labelEn, labelAr, value }].
  specs                 Json?
  /// Outer dimensions in millimetres: width × depth × height.
  widthMm               Int?
  depthMm               Int?
  heightMm              Int?
  weightKg              Float?
  energyType            EnergyType?
  /// Gases the machine accepts; empty for electric machines.
  gasTypes              GasType[]
  /// Electric power, or rated heat input for gas machines.
  powerKw               Float?
  voltage               Int?
  /// 1 (single-phase) or 3 (three-phase).
  phases                Int?
  frequencyHz           Int?
  currentAmps           Float?
  /// True when currentAmps was calculated from power and voltage instead of read from the supplier.
  currentAmpsCalculated Boolean                @default(false)
  /// e.g. ["CE"]. Shown on the product page.
  certifications        String[]
  /// Higher shows first inside a category: the biggest, most powerful machines lead.
  displayRank           Int                    @default(0)
  /// Hidden from the public site until true, so a product can be prepared first.
  published             Boolean                @default(false)
  categoryId            String
  category              Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants              ProductVariant[]
  images                ProductImage[]
  suppliers             SupplierProduct[]
  /// Other subcategories that list this product too (e.g. a bowl cutter also under Food processors).
  extraCategories       ProductExtraCategory[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([categoryId, displayRank])
  @@index([published])
  @@map("products")
}

/// A size or model of a product, e.g. a cooking line in 90, 120 and 150 cm. Every product has at least one.
model ProductVariant {
  id            String  @id @default(uuid())
  productId     String
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku           String? @unique
  labelEn       String
  labelAr       String
  /// Specs specific to this variant (width, power…), same shape as Product.specs.
  specs         Json?
  /// Smallest currency unit (e.g. cents) to avoid floating-point rounding.
  priceAmount   Int?
  priceCurrency String?
  sortOrder     Int     @default(0)

  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  key       String
  altEn     String?
  altAr     String?
  /// The lowest sortOrder is the main image.
  sortOrder Int     @default(0)

  @@index([productId])
  @@map("product_images")
}

/// A company we buy from. Admin-only: nothing about suppliers is ever shown on the public site.
model Supplier {
  id             String            @id @default(uuid())
  name           String
  /// Lower-case name without punctuation or company suffixes ("co", "ltd"…), used to spot duplicates.
  normalizedName String            @unique
  /// Name in the supplier's own language, e.g. Chinese.
  nameLocal      String?
  country        String?
  city           String?
  address        String?
  website        String?
  email          String?
  phone          String?
  /// Our own notes about this supplier (quality, terms, how dealing with them went…).
  notes          String?
  contacts       SupplierContact[]
  products       SupplierProduct[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@map("suppliers")
}

/// A person we talk to at a supplier.
model SupplierContact {
  id         String   @id @default(uuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  name       String
  role       String?
  email      String?
  phone      String?
  whatsapp   String?
  wechat     String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([supplierId])
  @@map("supplier_contacts")
}

/// "This supplier makes this product": their model code, their price when we have it, and where
/// it is in their catalog. Searching our product code lists every supplier through this table.
model SupplierProduct {
  id             String   @id @default(uuid())
  supplierId     String
  supplier       Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// The supplier's own model code, e.g. "CNIX-E2000".
  supplierModel  String
  /// Our cost from this supplier in the smallest currency unit (cents). Admin-only.
  priceAmount    Int?
  /// ISO 4217 code, e.g. "USD".
  priceCurrency  String?
  /// Page in the supplier's catalog where the model appears.
  catalogPage    Int?
  /// The product photo as cut from their catalog, before cleaning. Kept for reference.
  sourceImageKey String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  /// A supplier lists each model once; also lets an import skip models it already added.
  @@unique([supplierId, supplierModel])
  /// One link per supplier and product.
  @@unique([supplierId, productId])
  @@index([productId])
  @@map("supplier_products")
}

enum LeadSource {
  catalog_download
  quote
  contact
}

/// A visitor who left contact details (catalog PDF download or quote request).
model Lead {
  id             String        @id @default(uuid())
  email          String?
  phone          String?
  source         LeadSource
  name           String?
  /// Quote requests: the customer's business name and what they are building.
  company        String?
  projectType    String?
  message        String?
  businessTypeId String?
  businessType   BusinessType? @relation(fields: [businessTypeId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())

  @@index([createdAt])
  @@map("leads")
}

enum AgentRunStatus {
  idle
  running
  failed
}

/// A chat between an admin and an AI agent (e.g. "ahmadprod"). The agent can only read the catalog and
/// propose plans; anything it wants written waits in AgentPlan for an admin's approval.
model AgentConversation {
  id        String         @id @default(uuid())
  /// Which agent, e.g. "ahmadprod".
  agent     String
  title     String
  status    AgentRunStatus @default(idle)
  /// Last failure shown to the admin, cleared on the next run.
  lastError String?
  /// Catalog attached to the chat, kept in R2: sent to the model with each request and used to cut photos.
  fileKey   String?
  fileName  String?
  messages  AgentMessage[]
  plans     AgentPlan[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([agent, updatedAt])
  @@map("agent_conversations")
}

/// One turn, append-only. `content` is the exact Claude API content (text, tool calls, tool results,
/// thinking blocks) so the conversation can be replayed unchanged; `text` is what the chat shows.
model AgentMessage {
  id             String            @id @default(uuid())
  conversationId String
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// "user" or "assistant" (sent to Claude), or "event" (shown in the chat only, e.g. an import report).
  role           String
  content        Json
  text           String?
  createdAt      DateTime          @default(now())

  @@index([conversationId, createdAt])
  @@map("agent_messages")
}

enum AgentPlanStatus {
  pending
  approved
  rejected
  superseded
  executing
  done
  failed
}

/// What the agent wants to add, waiting for an admin. Nothing is written until it is approved, and then
/// our own code (not the AI) carries it out through the normal, validated use cases.
model AgentPlan {
  id             String            @id @default(uuid())
  conversationId String
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  status         AgentPlanStatus   @default(pending)
  plan           Json
  /// Execution report: what was created, linked, skipped or failed.
  result         Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([conversationId, createdAt])
  @@map("agent_plans")
}

/// A product listed in a second subcategory besides its own. Its code, page and back link follow its own category.
model ProductExtraCategory {
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_extra_categories")
}
