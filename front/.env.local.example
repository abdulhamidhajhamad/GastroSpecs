# Copy to .env.local. Variables prefixed with NEXT_PUBLIC_ are sent to the browser.

# Where the admin sign-in form (and later dashboard fetches) call the API.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Enables the public catalog page to fetch products from the backend.
# Leave empty to render the "Catalog coming soon" empty state.
CATALOG_API_URL=http://localhost:4000/api
